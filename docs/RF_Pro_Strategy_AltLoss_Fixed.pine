msg_short_open = input.text_area(defval="", title="空单-开仓/加仓 (Start Short)", group=group_3c)
msg_short_close= input.text_area(defval="", title="空单-全部平仓 (Close Short)", group=group_3c)
msg_tp_part    = input.text_area(defval="", title="分批止盈消息 (Partial TP)", group=group_3c)

