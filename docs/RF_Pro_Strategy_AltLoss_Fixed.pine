useVolFilter = input.bool(true, "启用剧烈反转保护", group=group_prot)
volThreshold = input.float(2.0, "剧烈涨跌幅度阈值 (%)", step=0.1, group=group_prot)
volWaitBars = input.int(3, "冷静期 K线数", group=group_prot)

group_reentry = "14. ➕ 顺势回补 (Trend Following)"
allowTrendFollowEntry = input.bool(true, "启用顺势回补", group=group_reentry)

group_delay = "15. ⏰ 延迟执行设置 (修复未来函数)"
entryDelayBars = input.int(defval=1, minval=0, maxval=5, title="信号延迟K线数", group=group_delay)

use_barcolor = input.bool(true, "K线染色", group="UI")
timeGroup = "时间过滤"
skipWeekends = input.bool(true, "跳过周末", group=timeGroup)
weekendStartDay = input.int(6, "周六", group=timeGroup)
weekendStartHour = input.int(8, "8点", group=timeGroup)
weekendEndDay = input.int(1, "周一", group=timeGroup)
weekendEndHour = input.int(0, "0点", group=timeGroup)

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
// Logic Calculation
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
isWeekendBeijingTime() =>
    d = dayofweek(time), h = hour(time)
    (d == 6 and h >= weekendStartHour) or (d == 7) or (d == 1 and h < weekendEndHour)
isValidTradingTime() => not skipWeekends or not isWeekendBeijingTime()

main_rng_size = rng_size(rng_src, rng_qty, rng_per)
main_filt = rng_filt(rng_src, main_rng_size, rng_per)
h_band = main_filt + main_rng_size
l_band = main_filt - main_rng_size
var float main_dir = 0.0
main_dir := main_filt > main_filt[1] ? 1 : main_filt < main_filt[1] ? -1 : main_dir
main_upward = main_dir == 1
main_downward = main_dir == -1
fast_rng_size = rng_size(rng_src, fast_rng_qty, fast_rng_per)
fast_filt = rng_filt(rng_src, fast_rng_size, fast_rng_per)
var float fast_dir = 0.0
fast_dir := fast_filt > fast_filt[1] ? 1 : fast_filt < fast_filt[1] ? -1 : fast_dir
fast_upward = fast_dir == 1
fast_downward = fast_dir == -1

baseEmaValue = ta.ema(close, baseEmaPeriod)
momentumEmaValue = ta.ema(close, momentumEmaPeriod)
prevClose = close[1]
prevBaseEmaValue = baseEmaValue[1]
prevMomentumEmaValue = momentumEmaValue[1]
baseEmaFilterLong = not useBaseEma or prevClose > prevBaseEmaValue
baseEmaFilterShort = not useBaseEma or prevClose < prevBaseEmaValue
momentumEmaFilterLong = not useMomentumEma or prevClose > prevMomentumEmaValue
momentumEmaFilterShort = not useMomentumEma or prevClose < prevMomentumEmaValue

getEmaFilterCombined(baseLong, momentumLong, baseShort, momentumShort) =>
    var bool emaFilterLongResult = false
    var bool emaFilterShortResult = false
    if not useEmaFilter
        emaFilterLongResult := true
        emaFilterShortResult := true
    else
        if emaFilterMode == "两者都需要"
            emaFilterLongResult := baseLong and momentumLong
            emaFilterShortResult := baseShort and momentumShort
        else if emaFilterMode == "任一即可"
            emaFilterLongResult := baseLong or momentumLong
            emaFilterShortResult := baseShort or momentumShort
        else if emaFilterMode == "仅基础EMA"
            emaFilterLongResult := baseLong
            emaFilterShortResult := baseShort
        else if emaFilterMode == "仅动量EMA"
            emaFilterLongResult := momentumLong
            emaFilterShortResult := momentumShort
    [emaFilterLongResult, emaFilterShortResult]

[emaFilterLong, emaFilterShort] = getEmaFilterCombined(baseEmaFilterLong, momentumEmaFilterLong, baseEmaFilterShort, momentumEmaFilterShort)
emaGoldenCross = prevMomentumEmaValue > prevBaseEmaValue and prevMomentumEmaValue[1] <= prevBaseEmaValue[1]
emaDeadCross = prevMomentumEmaValue < prevBaseEmaValue and prevMomentumEmaValue[1] >= prevBaseEmaValue[1]

getMacdFilterCondition(macdLine, signalLine, histLine) =>
    var bool zeroLongResult = false
    var bool zeroShortResult = false
    if not useMacdZeroLine
        zeroLongResult := true
        zeroShortResult := true
    else
        if macdZeroFilter == "MACD线在零轴上方"
            zeroLongResult := macdLine > 0
            zeroShortResult := macdLine < 0
        else if macdZeroFilter == "MACD柱在零轴上方"
            zeroLongResult := histLine > 0
            zeroShortResult := histLine < 0
        else if macdZeroFilter == "信号线在零轴上方"
            zeroLongResult := signalLine > 0
            zeroShortResult := signalLine < 0
    var bool crossLongResult = false
    var bool crossShortResult = false
    if not useMacdCross
        crossLongResult := true
        crossShortResult := true
    else
        if macdCrossFilter == "MACD线上穿信号线"
            crossLongResult := macdLine > signalLine and macdLine[1] <= signalLine[1]
            crossShortResult := macdLine < signalLine and macdLine[1] >= signalLine[1]
        else if macdCrossFilter == "MACD柱转正"
            crossLongResult := histLine > 0 and histLine[1] <= 0
            crossShortResult := histLine < 0 and histLine[1] >= 0
        else if macdCrossFilter == "双线上穿零轴"
            crossLongResult := macdLine > 0 and macdLine[1] <= 0 and signalLine > 0 and signalLine[1] <= 0
            crossShortResult := macdLine < 0 and macdLine[1] >= 0 and signalLine < 0 and signalLine[1] >= 0
        if not crossLongResult and not crossShortResult
            crossLongResult := true
            crossShortResult := true
    var bool macdFilterLongResult = zeroLongResult and crossLongResult
    var bool macdFilterShortResult = zeroShortResult and crossShortResult
    [macdFilterLongResult, macdFilterShortResult]

[currMacdLine, currSignalLine, currHistLine] = calculateMACD(close, macdFastLength, macdSlowLength, macdSignalLength)
[currMacdFilterLong, currMacdFilterShort] = getMacdFilterCondition(currMacdLine[1], currSignalLine[1], currHistLine[1])

getTfResolution(tfLabel) =>
    if tfLabel == "当前周期"
        ""
    else if tfLabel == "5分钟"
        "5"
    else if tfLabel == "15分钟"
        "15"
    else if tfLabel == "30分钟"
        "30"
    else if tfLabel == "1小时"
        "60"
    else if tfLabel == "4小时"
        "240"
    else if tfLabel == "日线"
        "D"
    else
        ""

tf1Resolution = getTfResolution(tf1_label)
var bool tf1FilterLongResult = true
var bool tf1FilterShortResult = true
if tf1Resolution != ""
    close_tf1 = request.security(syminfo.tickerid, tf1Resolution, close, lookahead=barmerge.lookahead_off)
    [macdLine_tf1, signalLine_tf1, histLine_tf1] = calculateMACD(close_tf1, macdFastLength, macdSlowLength, macdSignalLength)
    [tempTf1FilterLong, tempTf1FilterShort] = getMacdFilterCondition(macdLine_tf1[1], signalLine_tf1[1], histLine_tf1[1])
    tf1FilterLongResult := tempTf1FilterLong
    tf1FilterShortResult := tempTf1FilterShort
else
    tf1FilterLongResult := currMacdFilterLong
    tf1FilterShortResult := currMacdFilterShort

tf2Resolution = getTfResolution(tf2_label)
var bool tf2FilterLongResult = true
var bool tf2FilterShortResult = true
if tf2Resolution != ""
    close_tf2 = request.security(syminfo.tickerid, tf2Resolution, close, lookahead=barmerge.lookahead_off)
    [macdLine_tf2, signalLine_tf2, histLine_tf2] = calculateMACD(close_tf2, macdFastLength, macdSlowLength, macdSignalLength)
    [tempTf2FilterLong, tempTf2FilterShort] = getMacdFilterCondition(macdLine_tf2[1], signalLine_tf2[1], histLine_tf2[1])
    tf2FilterLongResult := tempTf2FilterLong
    tf2FilterShortResult := tempTf2FilterShort
else
    tf2FilterLongResult := currMacdFilterLong
    tf2FilterShortResult := currMacdFilterShort

get2TfMacdFilterCombined() =>
    var bool twoTfMacdFilterLongResult = false
    var bool twoTfMacdFilterShortResult = false
    if not use2TfMacdFilter
        twoTfMacdFilterLongResult := true
        twoTfMacdFilterShortResult := true
    else
        tf1ValidLong = not useTf1Macd or tf1FilterLongResult
        tf1ValidShort = not useTf1Macd or tf1FilterShortResult
        tf2ValidLong = not useTf2Macd or tf2FilterLongResult
        tf2ValidShort = not useTf2Macd or tf2FilterShortResult
        if twoTfMacdFilterMode == "两者都需要"
            twoTfMacdFilterLongResult := tf1ValidLong and tf2ValidLong
            twoTfMacdFilterShortResult := tf1ValidShort and tf2ValidShort
        else if twoTfMacdFilterMode == "任一即可"
            anyValidLong = tf1ValidLong or tf2ValidLong
            anyValidShort = tf1ValidShort or tf2ValidShort
            if not (useTf1Macd or useTf2Macd)
                anyValidLong := true
                anyValidShort := true
            twoTfMacdFilterLongResult := anyValidLong
            twoTfMacdFilterShortResult := anyValidShort
        else if twoTfMacdFilterMode == "仅第一个周期"
            twoTfMacdFilterLongResult := tf1ValidLong
            twoTfMacdFilterShortResult := tf1ValidShort
        else if twoTfMacdFilterMode == "仅第二个周期"
            twoTfMacdFilterLongResult := tf2ValidLong
            twoTfMacdFilterShortResult := tf2ValidShort
    [twoTfMacdFilterLongResult, twoTfMacdFilterShortResult]

[twoTfMacdFilterLong, twoTfMacdFilterShort] = get2TfMacdFilterCombined()
currMacdGoldenCross = currMacdLine > currSignalLine and currMacdLine[1] <= currSignalLine[1]
currMacdDeadCross = currMacdLine < currSignalLine and currMacdLine[1] >= currSignalLine[1]

// === 🔄 智能亏损保护系统（仓位调整版）FIXED V3 + 连续同向恢复 ===
var bool protectionActive = false
var int protectionStartBar = 0
var int lastClosedTradeCount = 0
var int consecutiveSameDirection = 0
var string lastTradeDirection = ""
var float[] tradeDirs = array.new_float(0)
var float[] tradeResults = array.new_float(0)
var string[] tradeIds = array.new_string(0)

safeArrayGetFloat(arr, index) =>
    if array.size(arr) > index and index >= 0
        array.get(arr, index)
    else
        na
safeArrayGetString(arr, index) =>
    if array.size(arr) > index and index >= 0
        array.get(arr, index)
    else
        ""

isAlternatingLoss() =>
    if array.size(tradeDirs) < altLossThreshold
        false
    else
        checkCount = math.min(array.size(tradeDirs), altLossThreshold)
        var bool alternatingResult = true
        var bool allLossResult = true
        for i = 0 to checkCount - 2
            dir1 = safeArrayGetFloat(tradeDirs, i)
            dir2 = safeArrayGetFloat(tradeDirs, i + 1)
            if na(dir1) or na(dir2) or dir1 == dir2
                alternatingResult := false
                break
        for i = 0 to checkCount - 1
            result = safeArrayGetFloat(tradeResults, i)
            if not na(result) and result > 0
                allLossResult := false
                break
        alternatingResult and allLossResult

// 连续亏损：最近 N 笔全部亏损即触发（不要求多空交替）
isConsecutiveLoss() =>
    if array.size(tradeResults) < altLossThreshold
        false
    else
        checkCount = math.min(array.size(tradeResults), altLossThreshold)
        var bool allLoss = true
        for i = 0 to checkCount - 1
            result = safeArrayGetFloat(tradeResults, i)
            if not na(result) and result > 0
                allLoss := false
                break
        allLoss

// 同一条K线内多次平仓（如 Long_Base + Long_Add）只记 1 笔，用「最后平掉的那笔」的方向和盈亏，否则永远凑不出「多空交替」
if useAltLossProtection
    currentClosedTradeCount = strategy.closedtrades
    if currentClosedTradeCount > lastClosedTradeCount
        // 只取本批中「最后平掉的一笔」作为本 bar 的 1 条记录（避免同 bar 多笔同向导致从不交替）
        i = currentClosedTradeCount - 1
        if i >= 0
            tradeId = str.tostring(strategy.closedtrades.entry_id(i))
            var bool alreadyRecorded = false
            for j = 0 to array.size(tradeIds) - 1
                if j >= array.size(tradeIds)
                    break
                if safeArrayGetString(tradeIds, j) == tradeId
                    alreadyRecorded := true
                    break
            if not alreadyRecorded
                array.push(tradeIds, tradeId)
                tradeSize = strategy.closedtrades.size(i)
                tradeDir = tradeSize > 0 ? 1.0 : -1.0
                entryPrice = strategy.closedtrades.entry_price(i)
                exitPrice = strategy.closedtrades.exit_price(i)
                float profitPctValue = 0.0
                if tradeDir == 1
                    profitPctValue := (exitPrice - entryPrice) / entryPrice * 100
                else
                    profitPctValue := (entryPrice - exitPrice) / entryPrice * 100
                array.unshift(tradeDirs, tradeDir)
                array.unshift(tradeResults, profitPctValue)
                currentTradeDirection = tradeDir == 1 ? "LONG" : "SHORT"
                if lastTradeDirection == currentTradeDirection
                    consecutiveSameDirection := consecutiveSameDirection + 1
                else
                    consecutiveSameDirection := 1
                lastTradeDirection := currentTradeDirection
                maxRecords = altLossCheckLength
                while array.size(tradeDirs) > maxRecords
                    array.pop(tradeDirs)
                while array.size(tradeResults) > maxRecords
                    array.pop(tradeResults)
                while array.size(tradeIds) > maxRecords
                    array.pop(tradeIds)
                shouldActivate = (altLossTriggerMode == "交替亏损" and array.size(tradeDirs) >= altLossThreshold and isAlternatingLoss()) or (altLossTriggerMode == "连续亏损" and isConsecutiveLoss())
                if shouldActivate and not protectionActive
                    protectionActive := true
                    protectionStartBar := bar_index
                    if barstate.islast
                        label.new(bar_index, high, "🔴 智能保护激活\n降仓至 " + str.tostring(reducePositionPercent) + "%", color=color.red, style=label.style_label_down, size=size.normal)
        lastClosedTradeCount := currentClosedTradeCount

    // 2.5 连续同向恢复：满足「连续同向笔数」且（可选）最近一笔盈利则解除保护
    if useAltLossProtection and protectionActive
        needProfit = requireProfitForRecovery and array.size(tradeResults) > 0
        lastResult = safeArrayGetFloat(tradeResults, 0)
        profitOk = not needProfit or (not na(lastResult) and lastResult > 0)
        if consecutiveSameDirection >= sameDirectionRecovery and profitOk
            protectionActive := false

    // 3. 冷却期自动解除（备用）
    if useCoolingPeriod and protectionActive
        barsSinceProtection = bar_index - protectionStartBar
        if barsSinceProtection >= coolingBars
            protectionActive := false

prevRsiValue = ta.rsi(close[1], rsiLen)
rsiLongOk = not useRSIFilter or (prevRsiValue < rsiMaxLong)
rsiShortOk = not useRSIFilter or (prevRsiValue > rsiMinShort)
prevAtrValue = ta.atr(atrLength)
[diplus, diminus, adxValue] = ta.dmi(adxLen, adxLen)
bool adxPeaked = adxValue[1] < adxValue[2] and adxValue[2] >= adxValue[3] 
bool isTrendExhausted = useAdxExit and (adxValue[1] > adxThreshold) and adxPeaked
prevMidpointPrice = hl2[1]
prevShortSMA = ta.sma(prevMidpointPrice, 5)
prevLongSMA = ta.sma(prevMidpointPrice, 34)
prevAmazingOsc = prevShortSMA - prevLongSMA
prevRise = ta.rma(math.max(ta.change(prevAmazingOsc), 0), algoOscPeriod)
prevFall = ta.rma(-math.min(ta.change(prevAmazingOsc), 0), algoOscPeriod)
prevAlgoCustomRSI = (prevFall == 0 ? 100 : prevRise == 0 ? 0 : 100 - (100 / (1 + prevRise / prevFall))) - 50
var algoDurations = array.new_int()
prevAlgoCut = ta.barssince(ta.cross(prevAlgoCustomRSI, 0))
if prevAlgoCut == 0 and prevAlgoCut != prevAlgoCut[1]
    array.unshift(algoDurations, prevAlgoCut[1])
float algoRawBasis = array.size(algoDurations) > 0 ? array.avg(algoDurations) : na
float algoBasis = na(algoRawBasis) ? na : algoRawBasis + algoThresholdOffset 
algoBasis := math.max(1.0, algoBasis)
bool isAlgoReversalSignal = not na(algoBasis) and (prevAlgoCut >= algoBasis)
bool algoExitSignalLong = useAlgoExit and (prevAlgoCustomRSI > 0) and isAlgoReversalSignal
bool algoExitSignalShort = useAlgoExit and (prevAlgoCustomRSI < 0) and isAlgoReversalSignal

calculatePositionSize(entryPrice) =>
    var float qtyResult = 0.0
    if useMoneyManagement
        float actualAmount = fixedAmount
        float actualPercent = positionPercent
        if useAltLossProtection and protectionActive
            actualAmount := fixedAmount * (reducePositionPercent / 100.0)
            actualPercent := positionPercent * (reducePositionPercent / 100.0)
        if positionSizeType == "固定金额"
            qtyResult := actualAmount / entryPrice
        else
            float currentEquity = strategy.equity
            float tradeAmount = actualPercent / 100.0 * currentEquity
            qtyResult := tradeAmount / entryPrice
    else
        qtyResult := 1000 / entryPrice
    qtyResult := math.max(qtyResult, 0.000001)
    qtyResult

getActualAmountInfo() =>
    string info = ""
    if useMoneyManagement
        if positionSizeType == "固定金额"
            float actualAmt = fixedAmount
            if useAltLossProtection and protectionActive
                actualAmt := fixedAmount * (reducePositionPercent / 100.0)
            info := "金额:$" + str.tostring(actualAmt, "#,##0.00")
        else
            float actualPct = positionPercent
            if useAltLossProtection and protectionActive
                actualPct := positionPercent * (reducePositionPercent / 100.0)
            info := "比例:" + str.tostring(actualPct, "#.#") + "%"
    else
        info := "无资金管理"
    info

calcInitialSL(price, isLong) =>
    var float slPriceResult = na
    var float slFixedResult = na
    if useFixedSL
        distFixed = price * (stopLossPercent / 100)
        slFixedResult := isLong ? price - distFixed : price + distFixed
    var float slAtrResult = na
    if useAtrSL
        distAtr = prevAtrValue * atrMultiplier
        slAtrResult := isLong ? price - distAtr : price + distAtr
    if not na(slFixedResult) and not na(slAtrResult)
        slPriceResult := isLong ? math.max(slFixedResult, slAtrResult) : math.min(slFixedResult, slAtrResult)
    else if not na(slFixedResult)
        slPriceResult := slFixedResult
    else if not na(slAtrResult)
        slPriceResult := slAtrResult
    slPriceResult

var float longEntryPrice = na
var float shortEntryPrice = na
var float longInitialStop = na
var float shortInitialStop = na
var bool trailingActiveLong = false
var bool trailingActiveShort = false
var float highSinceEntryLong = na 
var float lowSinceEntryShort = na 
var float trailingStopPriceLong = na
var float trailingStopPriceShort = na
var bool isTp1Executed = false 
var bool isTp2Executed = false 
var bool isTp3Executed = false 
bool isLongProfit = strategy.position_size > 0 ? (close[1] > strategy.position_avg_price) : false
bool isShortProfit = strategy.position_size < 0 ? (close[1] < strategy.position_avg_price) : false
barChangePct = math.abs(close[1] - close[2]) / close[2] * 100
prevMainUpward = main_upward[1]
prevMainDownward = main_downward[1]
prevFastUpward = fast_upward[1]
prevFastDownward = fast_downward[1]
rawTrendReversalLong = prevMainUpward and (not prevMainUpward[1] or prevMainDownward[1]) and rsiLongOk
rawTrendReversalShort = prevMainDownward and (not prevMainDownward[1] or prevMainUpward[1]) and rsiShortOk
var int lastViolentBarIdx = -999
if (rawTrendReversalLong[1] or rawTrendReversalShort[1]) and barChangePct[1] > volThreshold
    lastViolentBarIdx := bar_index[1]
inCooldown = (bar_index - lastViolentBarIdx) <= volWaitBars
triggerLong = prevMainUpward and prevFastUpward and (not prevFastUpward[1] or prevFastDownward[1]) and rsiLongOk
triggerShort = prevMainDownward and prevFastDownward and (not prevFastDownward[1] or prevFastUpward[1]) and rsiShortOk
trendFollowBuy = allowTrendFollowEntry and (strategy.position_size == 0) and prevMainUpward and triggerLong
trendFollowSell = allowTrendFollowEntry and (strategy.position_size == 0) and prevMainDownward and triggerShort
allowPyramidLong = (strategy.position_size == 0) or (strategy.opentrades < max_layers and (pyramid_safe ? isLongProfit : true))
allowPyramidShort = (strategy.position_size == 0) or (strategy.opentrades < max_layers and (pyramid_safe ? isShortProfit : true))
finalFilterLong = emaFilterLong and twoTfMacdFilterLong
finalFilterShort = emaFilterShort and twoTfMacdFilterShort
delayedEntryLong = (rawTrendReversalLong or trendFollowBuy) and (not useVolFilter or not inCooldown) and finalFilterLong
delayedEntryShort = (rawTrendReversalShort or trendFollowSell) and (not useVolFilter or not inCooldown) and finalFilterShort
delayedAddLong = useReentry and triggerLong and not rawTrendReversalLong and allowPyramidLong and finalFilterLong
delayedAddShort = useReentry and triggerShort and not rawTrendReversalShort and allowPyramidShort and finalFilterShort
strategy.risk.max_position_size(max_layers)

get_alert_msg(msg) => str.length(msg) > 0 ? msg : na

if isValidTradingTime()
    if delayedEntryLong
        if strategy.position_size < 0
            strategy.close_all(comment="平空反手", alert_message=get_alert_msg(msg_short_close))
        float longQty = calculatePositionSize(open)
        string actualAmountInfo = getActualAmountInfo()
        string comment_txt = rawTrendReversalLong ? "开多(主)" : "开多(补)"
        if not emaFilterLong and useEmaFilter
            comment_txt := comment_txt + " [EMA过滤]"
        if not twoTfMacdFilterLong and use2TfMacdFilter
            comment_txt := comment_txt + " [双周期MACD过滤]"
        if useAltLossProtection and protectionActive
            comment_txt := comment_txt + " [减仓模式-" + str.tostring(reducePositionPercent) + "%]"
        comment_txt := comment_txt + " | " + actualAmountInfo
        if barstate.islast
            comment_txt := comment_txt + " | 数量:" + str.tostring(longQty, "#.####")
        strategy.entry("Long_Base", strategy.long, qty=longQty, comment=comment_txt, alert_message=get_alert_msg(msg_long_open))
        longEntryPrice := open
        longInitialStop := calcInitialSL(open, true)
        trailingActiveLong := false
        highSinceEntryLong := open
        trailingStopPriceLong := na
        isTp1Executed := false 
        isTp2Executed := false 
        isTp3Executed := false 
        shortEntryPrice := na
        shortInitialStop := na
        trailingActiveShort := false
    else if delayedAddLong
        float addLongQty = calculatePositionSize(open)
        string actualAmountInfo = getActualAmountInfo()
        string add_comment = "加多"
        if not emaFilterLong and useEmaFilter
            add_comment := add_comment + " [EMA过滤]"
        if not twoTfMacdFilterLong and use2TfMacdFilter
            add_comment := add_comment + " [双周期MACD过滤]"
        if useAltLossProtection and protectionActive
            add_comment := add_comment + " [减仓模式-" + str.tostring(reducePositionPercent) + "%]"
        add_comment := add_comment + " | " + actualAmountInfo
        if barstate.islast
            add_comment := add_comment + " | 数量:" + str.tostring(addLongQty, "#.####")
        strategy.entry("Long_Add", strategy.long, qty=addLongQty, comment=add_comment, alert_message=get_alert_msg(msg_long_open))
        longEntryPrice := open 
    if delayedEntryShort
        if strategy.position_size > 0
            strategy.close_all(comment="平多反手", alert_message=get_alert_msg(msg_long_close))
        float shortQty = calculatePositionSize(open)
        string actualAmountInfo = getActualAmountInfo()
        string comment_txt = rawTrendReversalShort ? "开空(主)" : "开空(补)"
        if not emaFilterShort and useEmaFilter
            comment_txt := comment_txt + " [EMA过滤]"
        if not twoTfMacdFilterShort and use2TfMacdFilter
            comment_txt := comment_txt + " [双周期MACD过滤]"
        if useAltLossProtection and protectionActive
            comment_txt := comment_txt + " [减仓模式-" + str.tostring(reducePositionPercent) + "%]"
        comment_txt := comment_txt + " | " + actualAmountInfo
        if barstate.islast
            comment_txt := comment_txt + " | 数量:" + str.tostring(shortQty, "#.####")
        strategy.entry("Short_Base", strategy.short, qty=shortQty, comment=comment_txt, alert_message=get_alert_msg(msg_short_open))
        shortEntryPrice := open
        shortInitialStop := calcInitialSL(open, false)
        trailingActiveShort := false
        lowSinceEntryShort := open
        trailingStopPriceShort := na
        isTp1Executed := false 
        isTp2Executed := false 
        isTp3Executed := false 
        longEntryPrice := na
        longInitialStop := na
        trailingActiveLong := false
    else if delayedAddShort
        float addShortQty = calculatePositionSize(open)
        string actualAmountInfo = getActualAmountInfo()
        string add_comment = "加空"
        if not emaFilterShort and useEmaFilter
            add_comment := add_comment + " [EMA过滤]"
        if not twoTfMacdFilterShort and use2TfMacdFilter
            add_comment := add_comment + " [双周期MACD过滤]"
        if useAltLossProtection and protectionActive
            add_comment := add_comment + " [减仓模式-" + str.tostring(reducePositionPercent) + "%]"
        add_comment := add_comment + " | " + actualAmountInfo
        if barstate.islast
            add_comment := add_comment + " | 数量:" + str.tostring(addShortQty, "#.####")
        strategy.entry("Short_Add", strategy.short, qty=addShortQty, comment=add_comment, alert_message=get_alert_msg(msg_short_open))
        shortEntryPrice := open

float currentOpenProfitPctValue = 0.0
if strategy.position_size != 0
    if strategy.position_size > 0
        currentOpenProfitPctValue := (close[1] - strategy.position_avg_price) / strategy.position_avg_price * 100
    else
        currentOpenProfitPctValue := (strategy.position_avg_price - close[1]) / strategy.position_avg_price * 100

if strategy.position_size != 0
    if useTP1 and not isTp1Executed and currentOpenProfitPctValue >= tp1Trigger
        strategy.close("Long_Base", qty_percent=tp1Qty / 100.0, comment="💰TP1", alert_message=get_alert_msg(msg_tp_part))
        strategy.close("Long_Add", qty_percent=tp1Qty / 100.0, comment="💰TP1", alert_message=get_alert_msg(msg_tp_part))
        strategy.close("Short_Base", qty_percent=tp1Qty / 100.0, comment="💰TP1", alert_message=get_alert_msg(msg_tp_part))
        strategy.close("Short_Add", qty_percent=tp1Qty / 100.0, comment="💰TP1", alert_message=get_alert_msg(msg_tp_part))
        isTp1Executed := true
    if useTP2 and not isTp2Executed and currentOpenProfitPctValue >= tp2Trigger
        strategy.close("Long_Base", qty_percent=tp2Qty / 100.0, comment="💰TP2", alert_message=get_alert_msg(msg_tp_part))
        strategy.close("Long_Add", qty_percent=tp2Qty / 100.0, comment="💰TP2", alert_message=get_alert_msg(msg_tp_part))
        strategy.close("Short_Base", qty_percent=tp2Qty / 100.0, comment="💰TP2", alert_message=get_alert_msg(msg_tp_part))
        strategy.close("Short_Add", qty_percent=tp2Qty / 100.0, comment="💰TP2", alert_message=get_alert_msg(msg_tp_part))
        isTp2Executed := true
    if useTP3 and not isTp3Executed and currentOpenProfitPctValue >= tp3Trigger
        strategy.close("Long_Base", qty_percent=tp3Qty / 100.0, comment="💰TP3", alert_message=get_alert_msg(msg_tp_part))
        strategy.close("Long_Add", qty_percent=tp3Qty / 100.0, comment="💰TP3", alert_message=get_alert_msg(msg_tp_part))
        strategy.close("Short_Base", qty_percent=tp3Qty / 100.0, comment="💰TP3", alert_message=get_alert_msg(msg_tp_part))
        strategy.close("Short_Add", qty_percent=tp3Qty / 100.0, comment="💰TP3", alert_message=get_alert_msg(msg_tp_part))
        isTp3Executed := true

if strategy.position_size > 0 
    if high[1] > nz(highSinceEntryLong, high[1])
        highSinceEntryLong := high[1]
    if useTrailing and highSinceEntryLong >= longEntryPrice + (prevAtrValue * trailTriggerMult)
        trailingActiveLong := true
    float atrStopPrice = highSinceEntryLong - (prevAtrValue * trailOffsetMult)
    float candidateStop = trailingActiveLong ? atrStopPrice : longInitialStop
    if not na(candidateStop)
        if na(trailingStopPriceLong) or candidateStop > trailingStopPriceLong
            trailingStopPriceLong := candidateStop
if strategy.position_size < 0
    if low[1] < nz(lowSinceEntryShort, low[1])
        lowSinceEntryShort := low[1]
    if useTrailing and lowSinceEntryShort <= shortEntryPrice - (prevAtrValue * trailTriggerMult)
        trailingActiveShort := true
    float atrStopPriceS = lowSinceEntryShort + (prevAtrValue * trailOffsetMult)
    float candidateStopS = trailingActiveShort ? atrStopPriceS : shortInitialStop
    if not na(candidateStopS)
        if na(trailingStopPriceShort) or candidateStopS < trailingStopPriceShort
            trailingStopPriceShort := candidateStopS

bool adxConditionLong = strategy.position_size > 0 and isTrendExhausted
bool adxConditionShort = strategy.position_size < 0 and isTrendExhausted
bool adxLongExit = adxConditionLong and (currentOpenProfitPctValue >= adxMinProfitPct)
bool adxShortExit = adxConditionShort and (currentOpenProfitPctValue >= adxMinProfitPct)

if strategy.position_size > 0
    if algoExitSignalLong
        strategy.close_all(comment="⚠️Algo反转", alert_message=get_alert_msg(msg_long_close))
        longEntryPrice := na
    else if adxLongExit
        strategy.close("Long_Base", qty_percent=adxExitQty / 100.0, comment="📉ADX止盈", alert_message=get_alert_msg(msg_tp_part))
        strategy.close("Long_Add", qty_percent=adxExitQty / 100.0, comment="📉ADX止盈", alert_message=get_alert_msg(msg_tp_part))
        if adxExitQty >= 100
            longEntryPrice := na
    else if not na(trailingStopPriceLong) and low[1] <= trailingStopPriceLong
        strategy.close_all(comment="ATR移损", alert_message=get_alert_msg(msg_long_close))
        longEntryPrice := na
    else if not na(longInitialStop) and low[1] <= longInitialStop and not trailingActiveLong
        strategy.close_all(comment="硬止损", alert_message=get_alert_msg(msg_long_close))
if strategy.position_size < 0
    if algoExitSignalShort
        strategy.close_all(comment="⚠️Algo反转", alert_message=get_alert_msg(msg_short_close))
        shortEntryPrice := na
    else if adxShortExit
        strategy.close("Short_Base", qty_percent=adxExitQty / 100.0, comment="📉ADX止盈", alert_message=get_alert_msg(msg_tp_part))
        strategy.close("Short_Add", qty_percent=adxExitQty / 100.0, comment="📉ADX止盈", alert_message=get_alert_msg(msg_tp_part))
        if adxExitQty >= 100
            shortEntryPrice := na
    else if not na(trailingStopPriceShort) and high[1] >= trailingStopPriceShort
        strategy.close_all(comment="ATR移损", alert_message=get_alert_msg(msg_short_close))
        shortEntryPrice := na
    else if not na(shortInitialStop) and high[1] >= shortInitialStop and not trailingActiveShort
        strategy.close_all(comment="硬止损", alert_message=get_alert_msg(msg_short_close))

if not isValidTradingTime() and strategy.position_size != 0
    string close_msg = strategy.position_size > 0 ? msg_long_close : msg_short_close
    strategy.close_all(comment="休市平仓", alert_message=get_alert_msg(close_msg))

baseEmaPlotValue = showBaseEmaLine ? baseEmaValue : na
plot(baseEmaPlotValue, color=baseEmaColor, linewidth=2, title="基础EMA")
momentumEmaPlotValue = showMomentumEmaLine ? momentumEmaValue : na
plot(momentumEmaPlotValue, color=momentumEmaColor, linewidth=1, title="动量EMA")
filt_color = main_upward ? #05ff9b : main_downward ? #ff0583 : #cccccc
p_main = plot(main_filt, color=color.new(filt_color, 20), linewidth=3, title="Main Filter")
h_band_plot = plot(h_band, color=color.new(#05ff9b, 100), title="H Band")
l_band_plot = plot(l_band, color=color.new(#ff0583, 100), title="L Band")
fill(h_band_plot, p_main, color=color.new(#00b36b, 92), title="H Fill")
fill(l_band_plot, p_main, color=color.new(#b8005d, 92), title="L Fill")
fast_color = fast_upward ? color.yellow : color.fuchsia
fastPlotValue = useReentry ? fast_filt : na
plot(fastPlotValue, color=color.new(fast_color, 50), linewidth=1, title="Fast Signal", style=plot.style_line)
avgPricePlotValue = strategy.position_size != 0 ? strategy.position_avg_price : na
plot(avgPricePlotValue, color=color.white, style=plot.style_linebr, linewidth=1, title="Avg Price")
trailLongPlotValue = strategy.position_size > 0 ? trailingStopPriceLong : na
plot(trailLongPlotValue, color=color.new(color.blue, 20), style=plot.style_linebr, title="Trailing Stop", linewidth=2)
trailShortPlotValue = strategy.position_size < 0 ? trailingStopPriceShort : na
plot(trailShortPlotValue, color=color.new(color.blue, 20), style=plot.style_linebr, title="Trailing Stop", linewidth=2)
plotshape(emaGoldenCross, style=shape.triangleup, location=location.bottom, color=color.green, size=size.small, title="EMA金叉")
plotshape(emaDeadCross, style=shape.triangledown, location=location.top, color=color.red, size=size.small, title="EMA死叉")
plotshape(currMacdGoldenCross and use2TfMacdFilter, style=shape.circle, location=location.bottom, color=color.green, size=size.tiny, title="MACD金叉")
plotshape(currMacdDeadCross and use2TfMacdFilter, style=shape.circle, location=location.top, color=color.red, size=size.tiny, title="MACD死叉")
plotshape(delayedEntryLong and isValidTradingTime(), style=shape.triangleup, location=location.belowbar, color=finalFilterLong ? color.green : color.gray, size=size.small, title="Long Entry")
plotshape(delayedEntryShort and isValidTradingTime(), style=shape.triangledown, location=location.abovebar, color=finalFilterShort ? color.red : color.gray, size=size.small, title="Short Entry")
plotshape(algoExitSignalLong and strategy.position_size > 0, style=shape.xcross, location=location.abovebar, color=color.orange, size=size.tiny, title="Algo Exit")
plotshape(algoExitSignalShort and strategy.position_size < 0, style=shape.xcross, location=location.belowbar, color=color.orange, size=size.tiny, title="Algo Exit")
bgcolor(protectionActive ? color.new(color.orange, 80) : na, title="保护激活背景")
