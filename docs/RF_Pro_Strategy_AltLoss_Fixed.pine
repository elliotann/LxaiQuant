// Modified by Wall Street Trend Trader: RF Pro + ADX Only + AlgoAlpha Reversal + 3-Stage Partial TP
// Integrated with 3Commas by Gemini
// Added: Anti-Whipsaw Protection + Trend Following Re-entry + Partial ADX Exit + EMA Trend Filter
// Added: Dual EMA Control System (Base + Momentum)
// Added: 2-Timeframe MACD Filter (User Selectable)
// Added: Improved Alternating Loss Protection with Test Trade
// FIXED: 智能亏损保护 - 增加「连续同向恢复」逻辑，确保回测中生效
//@version=6
strategy(title="RF Pro Strategy (3Commas + Re-entry + Partial Exit + Dual EMA + 2-TF MACD + Improved AltLoss)", 
         shorttitle="RF_Pro_Adv_Improved_AltLoss", 
         overlay=true, 
         pyramiding=10, 
         initial_capital=10000, 
         default_qty_type=strategy.cash,
         default_qty_value=10000,
         process_orders_on_close=false,
         currency=currency.USD)

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
// Functions
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
rng_size(x, qty, n) => 
    wper = n * 2 - 1
    avrng = ta.ema(math.abs(x - x[1]), n)
    AC = ta.ema(avrng, wper) * qty
    AC
rng_filt(x, rng_, n) =>
    r = rng_
    var rfilt = array.new_float(2, x)
    array.set(rfilt, 1, array.get(rfilt, 0))
    if x - r > array.get(rfilt, 1)
        array.set(rfilt, 0, x - r)
    if x + r < array.get(rfilt, 1)
        array.set(rfilt, 0, x + r)
    rng_filt1 = array.get(rfilt, 0)
    rng_filt1
calculateMACD(src, fastLength, slowLength, signalLength) =>
    fastMA = ta.ema(src, fastLength)
    slowMA = ta.ema(src, slowLength)
    macdLine = fastMA - slowMA
    signalLine = ta.ema(macdLine, signalLength)
    histLine = macdLine - signalLine
    [macdLine, signalLine, histLine]

//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
// Inputs
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------
